---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Share from '../../components/Share.astro';
import AdSlot from '../../components/AdSlot.astro';
import MoreTools from '../../components/MoreTools.astro';
import { PercentageToGpa } from '../../components/islands/Converters';
import { webAppLd, breadcrumbLd, BUILD_DATE_ISO } from '../../lib/seo';
import { absoluteUrl, withBase } from '../../lib/url';

const title = 'Percentage to GPA Converter';
const description = 'Convert a percentage grade to a letter grade and GPA points on the standard 4.0 scale, using a common convention for the bands.';
const faqs = [
  {
    q: 'What percentage is a 4.0 GPA?',
    a: 'Under the common convention, 93% and above is an A (4.0 grade points). Some schools start the A range at 90% instead — check your syllabus.',
  },
  {
    q: 'Does this match my school\'s exact scale?',
    a: 'It uses a widely-used common convention, not one official published standard. Your school may use different cutoffs — see the <a href="' + withBase('/gpa-scale/us-4-0/') + '">4.0 scale page</a> or your registrar\'s published scale for the exact figures used on your transcript.',
  },
];
---

<Base
  title={title}
  description={description}
  jsonLd={[webAppLd({ name: 'Percentage to GPA Converter', url: '/percentage-to-gpa/', description }), breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Percentage to GPA', url: '/percentage-to-gpa/' }])]}
>
  <article class="container container--narrow section">
    <Breadcrumbs items={[{ name: 'Home', url: '/' }, { name: 'Percentage to GPA', url: '/percentage-to-gpa/' }]} />
    <h1>Percentage to GPA Converter</h1>
    <p class="lead">Enter a percentage grade to see its letter grade and GPA points on the standard 4.0 scale.</p>
    <p class="muted small">Last updated {BUILD_DATE_ISO}</p>
  </article>

  <section class="container" aria-label="Percentage to GPA converter">
    <PercentageToGpa client:load />
  </section>

  <AdSlot slot="pct-to-gpa-below-tool" minHeight={90} />

  <article class="container container--narrow section prose">
    <p>
      Need the reverse? Try <a href={withBase('/gpa-to-percentage/')}>GPA to percentage</a> or <a href={withBase('/letter-grade-to-gpa/')}>letter grade to GPA</a>. For a
      full course or semester, use the <a href={withBase('/gpa-calculator/')}>GPA calculator</a>.
    </p>
    <Share url={absoluteUrl('/percentage-to-gpa/')} text="Percentage to GPA Converter" />
  </article>

  <section class="container container--narrow">
    <Faq items={faqs} />
  </section>

  <MoreTools />
</Base>

<style>
  .lead {
    font-size: var(--text-lg);
    color: var(--fg-muted);
  }
</style>

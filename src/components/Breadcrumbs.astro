---
/**
 * Pure navigation — no JSON-LD here. The BreadcrumbList structured data for this same trail is
 * emitted once, in <head>, via the page's `jsonLd` prop to <Base> (see about.astro / contact.astro /
 * privacy.astro / terms.astro for the pages that don't already pass their own jsonLd). Emitting it
 * here too used to duplicate the BreadcrumbList block on every inner page.
 */
import { withBase } from '../lib/url';
interface Props {
  items: { name: string; url: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((it, i) => (
        <li>
          {i < items.length - 1 ? <a href={withBase(it.url)}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .breadcrumbs li + li::before {
    content: '/';
    margin: 0 var(--space-2);
    color: var(--border-strong);
  }
  .breadcrumbs a {
    color: var(--fg-muted);
  }
</style>
